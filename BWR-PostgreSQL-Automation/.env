PGHOST=RDS Endpoint
PGPORT=5432
PGUSER=
PGPASSWORD=
PGSSLMODE=require
# Optional: a comma-separated allowlist of databases to inspect.
# PGDATABASES=app360tf,postgres
REPORT_CLIENT=360tf
REPORT_OUTPUT_DIR=./reportsprod360tf

# Email delivery. The Word report is attached to the message automatically.
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=postgresql.alerts.new@gmail.com
SMTP_PASSWORD=APP Password
SMTP_FROM=postgresql.alerts.new@gmail.com
# Set true only if your SMTP server requires implicit SSL (normally port 465).
SMTP_USE_SSL=false
